---
import Layout from '../layouts/Layout.astro';
const wa = '64221260952';
const corporateMessage = encodeURIComponent('Hi Effulgent, I’d like to reserve a corporate gifting slot.');
const boxes = [
  ['Wine & Nibbles Box','Mini wine bottle, wine glass, local crackers & chocolate — fitted neatly in one box.','https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=80'],
  ['Self-Care Box','Candle, bath salts, local skincare, herbal tea.','https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=900&q=80'],
  ['Coffee Lover’s Box','Local roastery beans, quality mug, biscotti.','https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=900&q=80'],
  ['Premium Gourmet Box','Olive oil, dukkah, preserves, branded card.','https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=900&q=80'],
];
const addOns = [['Company Logo Tag','Printed tag on every gift.','+$3'],['Branded Ribbon & Wrapping','Colour-matched to your brand.','+$5'],['Personalised Recipient Cards','Handwritten name & message.','+$2'],['Custom Item Selection','Dietary needs & preferences.','+$7']];
---
<Layout active="corporate" title="Corporate Christmas Gifting in Auckland | Effulgent" description="Effulgent provides curated corporate gift boxes, custom branding, wrapping, and delivery for teams and clients in Auckland.">
  <section class="page-hero"><div class="page-hero-inner"><span class="eyebrow">Corporate Christmas Gifting</span><h1>Handled beautifully, start to finish</h1><p>Tell us your headcount and budget — we’ll source, wrap, and deliver gifts your team and clients will actually remember.</p><div class="benefit-row"><span class="benefit">Locally sourced</span><span class="benefit">Fully wrapped & delivered</span><span class="benefit">Custom branding available</span></div></div></section>
  <section class="section"><div class="section-inner"><div class="section-heading"><div><span class="section-kicker">Curated with care</span><h2>Gift boxes people will remember</h2></div><p>Every box is curated, wrapped, and ready to gift — mix and match across one order.</p></div><div class="box-grid">{boxes.map(([name,copy,image])=><article class="box-card"><div class="box-image" style={`background-image:url('${image}')`} role="img" aria-label={name}></div><div class="box-copy"><h3>{name}</h3><p>{copy}</p></div></article>)}</div><div class="section-action"><a class="btn" data-track="corporate_quote_click" href={`https://wa.me/${wa}?text=${corporateMessage}`} target="_blank" rel="noreferrer">Ask about corporate gifting <span>↗</span></a></div></div></section>
  <section class="section soft"><div class="section-inner"><div class="section-heading"><div><span class="section-kicker">Designed for your order size</span><h2>Founding Client launch rate</h2></div><p>Lock in this rate now — it carries over to your 2027 Christmas order too.</p></div><div class="table-wrap"><table><thead><tr><th>Quantity</th><th>Includes</th><th>Price per gift</th></tr></thead><tbody><tr><td>5–9 gifts</td><td>Choice of box, festive wrapping, delivery coordination</td><td><strong>NZ$55</strong></td></tr><tr class="featured-row"><td><strong>10–19 gifts</strong><br /><span class="section-kicker" style="margin:8px 0 0">Popular</span></td><td>Choice of box, festive wrapping, personalised card, delivery</td><td><strong>NZ$45</strong></td></tr><tr><td>20+ gifts</td><td>Choice of box, festive wrapping, personalised card, priority delivery</td><td><strong>NZ$38</strong></td></tr></tbody></table></div><p class="price-note">Founding Client Rate — available for a limited number of businesses booking their first Christmas order with us this year. Gift contents can be mixed across boxes within one order.</p></div></section>
  <section class="section"><div class="section-inner"><div class="section-heading"><div><span class="section-kicker">Your company, thoughtfully included</span><h2>Make it yours</h2></div><p>Add your company’s touch to every gift.</p></div><div class="addon-grid">{addOns.map(([name,copy,price])=><article class="addon"><h3>{name}</h3><p>{copy}</p><strong>{price} per gift</strong></article>)}</div><p class="price-note">Custom branding requires a minimum order of 10 gifts and 7 business days’ lead time.</p><div class="section-action"><a class="btn" href="/quote-calculator">Build your custom quote <span>↗</span></a></div></div></section>
  <section class="cta-panel"><h2>Reserve your Founding Client slot</h2><p>Launch pricing available for a limited number of businesses booking before 25 November 2026. Confirm the deadline before publishing.</p><a class="btn" data-track="corporate_quote_click" href={`https://wa.me/${wa}?text=${corporateMessage}`} target="_blank" rel="noreferrer">WhatsApp +64 22 126 0952 <span>↗</span></a><p class="hero-note" style="justify-content:center;margin-bottom:0">Founding Client bookings close 25 November 2026</p></section>
</Layout>
