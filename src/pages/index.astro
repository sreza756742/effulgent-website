---
import Layout from '../layouts/Layout.astro';
const wa = '64221260952';
const waMessage = encodeURIComponent('Hi Effulgent, I’d like to book a thoughtful gift surprise.');
const services = [['01','Personal Gift Shopping','I thoughtfully source gifts based on your budget, occasion, and the recipient’s personality.'],['02','Elegant Gift Wrapping','Each gift is wrapped beautifully with attention to detail and presentation.'],['03','Delivery Coordination','I organise delivery so your surprise arrives at the right place and the perfect time.'],['04','Occasion Planning Support','Birthdays, anniversaries, proposals, celebrations, apologies, and “just because”.'],['05','Last-Minute Surprises','Short on time? I offer fast-turnaround gifting when timing is tight.'],['06','Wrapping-Only Service','Already have the gift? I’ll wrap it beautifully and prepare it for delivery or pickup.']];
const packages = [{name:'Basic Package',price:'NZ$49',items:['Gift pick-up','Gift wrapping','Gift delivery coordination']},{name:'Standard Surprise',price:'NZ$95',featured:true,items:['Gift shopping','Custom gift wrapping','Personalised message card','In-person gift delivery']},{name:'Premium Experience',price:'NZ$149',items:['Gift sourcing or shopping','Custom gift wrapping','Personalised message card','In-person gift delivery','Bespoke add-ons']}];
const faqs = [['How does Effulgent work?','You message me your occasion, budget, and preferences. I take care of everything else.'],['Do I get to approve the gift?','Yes — you can approve the idea or leave it completely in my hands.'],['Where do you deliver?','I deliver within Auckland and surrounding areas.'],['Can the surprise be anonymous?','Absolutely. Your identity can remain private if you wish.'],['What occasions do you cover?','Birthdays, anniversaries, proposals, celebrations, apologies, and “just because”.'],['How far in advance should I book?','Ideally 3–5 days ahead, but last-minute requests are welcome when possible.']];
---
<Layout active="home" title="Effulgent | Personalised Gift Shopping, Wrapping & Delivery in Auckland" description="Effulgent makes gifting easy with personalised gift shopping, elegant wrapping, occasion planning, and delivery across Auckland and surrounding areas.">
<section class="hero"><div class="hero-content"><span class="eyebrow">A thoughtful journey · Care at every step</span><h1>Thoughtful gift surprises<br /><em>shopped, wrapped,</em><br />and delivered</h1><p>I take care of the planning, shopping, wrapping, and delivery — so you can give beautifully without the stress.</p><a class="btn" data-track="whatsapp_booking_click" href={`https://wa.me/${wa}?text=${waMessage}`} target="_blank" rel="noreferrer">Book via WhatsApp <span>↗</span></a><span class="hero-note">Auckland & surrounding areas</span></div></section>
<section class="section" id="services"><div class="section-inner"><div class="section-heading"><div><span class="section-kicker">From idea to arrival</span><h2>What I can handle for you</h2></div><p>From the first idea to the final delivery — every detail is handled with care.</p></div><div class="service-grid">{services.map(([n,title,copy])=><article class="service-card"><div class="service-icon">{n}</div><h3>{title}</h3><p>{copy}</p></article>)}</div><div class="section-action"><a class="btn" href={`https://wa.me/${wa}?text=${encodeURIComponent('Hi Effulgent, I’d like help with a personalised gift.')}`} target="_blank" rel="noreferrer">Ask about a service <span>↗</span></a></div></div></section>
<section class="section soft" id="pricing"><div class="section-inner"><div class="section-heading"><div><span class="section-kicker">Simple, transparent NZD service fees</span><h2>Pricing packages</h2></div><p>Gift cost is separate. Choose the level of care that suits your moment.</p></div><div class="pricing-grid">{packages.map((pkg)=><article class:list={['price-card',{featured:pkg.featured}]}>{pkg.featured&&<span class="ribbon">Most loved</span>}<h3>{pkg.name}</h3><p class="price">From {pkg.price}</p><ul>{pkg.items.map(item=><li>{item}</li>)}</ul></article>)}</div><div class="section-action"><a class="btn" href="/quote-calculator">Build your custom quote <span>↗</span></a></div><div class="corporate-strip"><p>Planning gifts for your team or clients?</p><a class="btn btn-outline" href="/corporate-gifting">See corporate gifting <span>↗</span></a></div></div></section>
<section class="section" id="faq"><div class="section-inner"><div class="section-heading"><div><span class="section-kicker">A little clarity</span><h2>Frequently asked questions</h2></div><p>Still wondering something? Message me and I’ll take care of the rest.</p></div><div class="faq-list">{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
<section class="cta-panel"><h2>Gifting made easy</h2><p>Message me and I’ll take care of the rest.</p><a class="btn" data-track="whatsapp_booking_click" href={`https://wa.me/${wa}?text=${waMessage}`} target="_blank" rel="noreferrer">WhatsApp <span>↗</span></a></section>
</Layout>

