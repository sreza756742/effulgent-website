---
const { title = 'Effulgent | Thoughtful gifting, personally delivered', description = 'Effulgent makes gifting easy with personalised gift shopping, elegant wrapping, occasion planning, and delivery across Auckland and surrounding areas.', active = '' } = Astro.props;
const wa = '64221260952';
const site = Astro.site ?? new URL('https://unique-belekoy-cd7b14.netlify.app');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL('/brand/effulgent-wordmark-forest.png', site).toString();
const waMessage = encodeURIComponent('Hi Effulgent, I’d like to enquire about a gift.');
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Effulgent',
  url: site,
  telephone: '+64 221260952',
  areaServed: { '@type': 'City', name: 'Auckland' },
  address: { '@type': 'PostalAddress', addressLocality: 'Auckland', addressCountry: 'NZ' },
  identifier: { '@type': 'PropertyValue', propertyID: 'NZBN', value: '651418152181' },
  description,
};
---
<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#233d35" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Effulgent" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)}></script>
</head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Effulgent home"><img src="/brand/effulgent-logo-green.png" alt="Effulgent" /></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" class="site-nav" aria-label="Main navigation">
        <a href="/#services">Services</a><a href="/#pricing">Pricing</a><a href="/#faq">FAQ</a>
        <a class:list:active={active === 'corporate'} href="/corporate-gifting">Corporate Gifting</a>
        <a class:list:active={active === 'quote'} href="/quote-calculator">Get a Quote</a>
        <a class="nav-cta" data-track="whatsapp_booking_click" href={`https://wa.me/${wa}?text=${waMessage}`} target="_blank" rel="noreferrer">Book <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-main"><div><a class="brand brand-light footer-logo" href="/"><img src="/brand/effulgent-footer-logo.png" alt="Effulgent" /></a><p>Your love. Personally delivered.</p></div><div class="footer-links"><a href="/terms">Terms of Service</a><a href="/privacy">Privacy Policy</a><a href="/corporate-gifting">Corporate Gifting</a></div><div class="footer-contact"><span>Auckland & surrounding areas</span><a href={`https://wa.me/${wa}`} target="_blank" rel="noreferrer">WhatsApp +64 22 126 0952</a><a href="tel:+64221260952">Call +64 22 126 0952</a></div></div>
      <div class="footer-bottom"><span>© 2026 Effulgent NZBN: 651418152181</span><span>Thoughtful gestures. Lasting connections.</span></div>
    </footer>
    <script>const toggle=document.querySelector('.menu-toggle');const nav=document.querySelector('.site-nav');toggle?.addEventListener('click',()=>{const open=nav.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open))});document.querySelectorAll('[data-track]').forEach(el=>el.addEventListener('click',()=>window.dispatchEvent(new CustomEvent('effulgent:track',{detail:el.dataset.track}))));</script>
  </body>
</html>
<style is:global>@import '../styles/global.css';</style>

